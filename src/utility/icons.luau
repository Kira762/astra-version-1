--[[
    Icon Resolver for Roblox Icons
    Maps icon names to raw GitHub URLs from Haijo12/roblox-icons

    Usage:
        local Icons = require(path.to.icons)
        local url = Icons.get("arrow-down")           -- defaults to lucide
        local url = Icons.get("arrow-down", "lucide") -- explicit pack
        local url = Icons.getByPack("material", "add")

    All icons are white on transparent background (24x24 PNG).
--]]

